APP_NAME="منيو كيو آر مصر"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=https://menu.yourdomain.eg

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# PostgreSQL Database Configuration (Coolify / Production)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=qrmenu
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Session & Cache (using Database driver for high stability)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# Egyptian SaaS Business Configuration
SAAS_ANNUAL_PRICE=300
ADMIN_SUPPORT_WHATSAPP=201000000000
ADMIN_SUPPORT_PHONE=01000000000

VITE_APP_NAME="${APP_NAME}"
